{
    "ReverseProxy": {
        "Routes": {
            "auth-openapi-route": {
                "ClusterId": "auth-cluster",
                "CorsPolicy": "GatewayCorsPolicy",
                "Match": {
                    "Path": "/auth-api/openapi/v1.json"
                },
                "Transforms": [
                    { "PathPattern": "/openapi/v1.json" }
                ]
            },
            "auth-route": {
                "ClusterId": "auth-cluster",
                "Match": {
                    "Path": "/auth-api/{**remainder}"
                },
                "Transforms": [
                    { "PathRemovePrefix": "/auth-api" }
                ]
            }
        },
        "Clusters": {
            "auth-cluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "http://localhost:50001/"
                    }
                }
            }
        }
    }
}