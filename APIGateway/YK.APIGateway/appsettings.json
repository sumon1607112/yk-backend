{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth-api/{**remainder}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth-api"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:50001/"
          }
        }
      }
    }
  }
}