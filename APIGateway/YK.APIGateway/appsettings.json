{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:7000",
      "http://localhost:7001"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth-api/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth-api" },
          {
            "X-Forwarded": "Set",
            "Prefix": "Off"
          },
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/auth-api"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:50001/"
          }
        }
      }
    }
  }
}