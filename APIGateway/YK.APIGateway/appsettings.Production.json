{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth-api/{**remainder}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth-api"
          },
          {
            "X-Forwarded": "Set",
            "Prefix": "Off"
          },
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/auth-api"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://yk-auth-api-hsgge9efffbbchhh.eastasia-01.azurewebsites.net/"
          }
        }
      }
    }
  }
}